{
  "manifest_version": 3,
  "name": "ContextLens \u2014 See the context",
  "version": "1.0.1",
  "description": "Blur repeated specific viral subjects, named places/products, actions and meme formats with selectable unique-post or account counts and opt-in Meta Muse Spark visual analysis.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*"
  ],
  "action": {
    "default_title": "ContextLens \u00b7 Settings",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "http://127.0.0.1:8765/*"
      ],
      "js": [
        "shared.js",
        "overlay.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
