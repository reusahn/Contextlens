# Copy to .env in project root. Used by the backend (with dotenv/config).
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Meta Model API credentials: backend only; never use a VITE_ prefix.
META_API_KEY=
# Only approved model; the backend budget guard rejects other values.
META_MODEL=muse-spark-1.3
# Emergency stop: true (or any value except literal false) blocks new Meta calls.
META_API_DISABLED=false
# Optional absolute path on persistent local disk; all backend workers MUST share it.
# META_BUDGET_DB=/var/lib/origintrace/meta-budget.sqlite
# Optional local speech recognition; requires ffmpeg and a local Whisper CLI/model.
# Local mode avoids paid transcription; SPEECH_PROVIDER=meta uses guarded Meta billing.
LOCAL_WHISPER_ENABLED=false
# WHISPER_COMMAND=/absolute/path/to/whisper
# Retrieval uses Meta Responses API web_search; no Tavily key is needed.
# Enable with META_SEARCH_BILLING_MODE=best_effort after accepting estimated
# query accounting (see README.md). Strict mode intentionally blocks search.
SEARCH_PROVIDER=meta
# Meta compares already retrieved article text under the same $100 budget guard.
META_TEXT_COMPARISON=true
# Current speech default is Meta; use local for Whisper, or off to disable speech.
SPEECH_PROVIDER=meta
# Public Instagram metadata fallback (requires yt-dlp; never reads cookies).
PLATFORM_EXTRACTION_ENABLED=true
# Optional local-only authenticated extraction; requires explicit session access.
# INSTAGRAM_COOKIES_BROWSER=chrome
# For another Chrome profile: INSTAGRAM_COOKIES_BROWSER=chrome:Profile 1
# Optional executable paths when the backend PATH lacks these tools.
# FFMPEG_COMMAND=/opt/homebrew/bin/ffmpeg
# YTDLP_COMMAND=/opt/homebrew/bin/yt-dlp
# Meta hosted-search adapter is available but requires explicit acceptance of
# best-effort billing instead of the original strict worst-case $100 guarantee.
META_SEARCH_BILLING_MODE=strict
# Only after accepting that tradeoff, use BOTH:
# SEARCH_PROVIDER=meta
# META_SEARCH_BILLING_MODE=best_effort
# Optional legacy provider: SEARCH_PROVIDER=tavily with TAVILY_API_KEY.
