{
  "name": "contextlens",
  "version": "1.0.1",
  "private": true,
  "description": "User-controlled repetition filtering with Meta visual observation and independent phenomenon verification",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "bridge": "node bridge/server.js",
    "feed": "node test-feed/server.js",
    "test": "node --test tests/*.test.cjs",
    "check": "node tools/check.cjs",
    "benchmark": "node tools/evaluate.cjs",
    "test:provider": "node tools/provider-smoke.cjs",
    "test:browser": "node tools/browser-smoke.cjs",
    "build:hybrid": "node tools/build-hybrid.cjs",
    "build:demo": "node tools/build-hybrid.cjs --web"
  },
  "dependencies": {
    "firebase": "13.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
